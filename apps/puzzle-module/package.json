{
  "name": "@futurx/puzzle-module",
  "version": "0.1.0",
  "private": true,
  "description": "Love Digitally — Puzzle Module. Standalone Ionic Angular PWA, deployed into the shared lovedigitally-app Firebase project under the puzzle_* namespace.",
  "scripts": {
    "dev": "ionic serve",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:deploy": "node scripts/apply-prod-env.mjs && ng build --configuration production && git checkout -- src/environments/environment.prod.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test",
    "lint": "ng lint",
    "pretest:e2e": "cd functions && npm run build",
    "test:e2e": "firebase emulators:exec --project lovedigitally-app --only auth,firestore,storage,functions \"npx playwright test\"",
    "firebase:emulators": "firebase emulators:start --project lovedigitally-app",
    "cap:sync": "ionic cap sync"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@ionic/angular": "^8.2.6",
    "firebase": "^10.14.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular-eslint/builder": "^18.3.0",
    "@angular-eslint/eslint-plugin": "^18.3.0",
    "@angular-eslint/eslint-plugin-template": "^18.3.0",
    "@angular-eslint/schematics": "^18.3.0",
    "@angular-eslint/template-parser": "^18.3.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "^6.1.2",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@ionic/cli": "^7.2.0",
    "@playwright/test": "^1.62.0",
    "@types/jasmine": "^5.1.4",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "firebase-tools": "^13.29.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "chokidar": "^4.0.0"
  }
}
